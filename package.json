{
  "name": "dsh-launcher",
  "productName": "DSH Launcher",
  "version": "0.1.5",
  "description": "DeepSeek Harness 启动器：自动下载运行时与 dsh、版本更新、插件安装与管理",
  "main": "./out/main/index.js",
  "author": "zhw000",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "cross-env DSH_E2E=1 vitest run test/e2e.test.ts",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
